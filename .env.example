GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIRM_NAME=Tanya Freeman Law LLC
LIVE_URL=

# Qdrant Cloud (use this on Render — embeddings run there, not in your instance RAM)
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
# Free Cloud Inference model. Enable Inference on the cluster in the Qdrant console.
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
EMBEDDING_VECTOR_SIZE=384
QDRANT_COLLECTION=lori_v3

# Local only (when QDRANT_URL is empty): FastEmbed + on-disk Qdrant
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=
